# Diretório de arquivos temporários de compilação
temp/*
!temp/.gitkeep

# Binários e executáveis gerados por execuções do usuário
*.exe
*.o
*.obj
*.out
*.bin
# Garantir que os binários do compilador portátil continuem rastreados
!compiler/**

# Relatórios e saídas de texto geradas por testes
historico_*.txt
relatorio_*.txt
saida_*.txt
output_*.txt

# Dependências do Node (caso algum pacote seja adicionado)
node_modules/

# Logs e dumps
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Arquivos do sistema operacional
Thumbs.db
.DS_Store
Desktop.ini

# IDEs e editores
.vscode/
.idea/
*.swp
